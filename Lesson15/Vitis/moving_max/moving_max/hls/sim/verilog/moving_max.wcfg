            <top_module name="moving_max_subsystem_pkg" />
            <top_module name="std" />
            <top_module name="uvm_pkg" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0ns"></ZoomStartTime>
      <ZoomEndTime time="2000ns"></ZoomEndTime>
      <Cursor1Time time="0ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="257"></NameColumnWidth>
      <ValueColumnWidth column_width="84"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="5" />
   <wvobject fp_name="HLS Process Summary Group" type="group">
      <obj_property name="label">HLS Process Summary</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <wvobject fp_name="/apatb_moving_max_top/AESL_inst_moving_max//AESL_inst_moving_max_activity" type="group">
         <obj_property name="label">AESL_inst_moving_max_activity</obj_property>
         <obj_property name="DisplayName">label</obj_property>
         <obj_property name="UseFullPath">true</obj_property>
         <obj_property name="ElementShortName">AESL_inst_moving_max_activity</obj_property>
         <obj_property name="ObjectShortName">AESL_inst_moving_max_activity</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
         <obj_property name="WaveformStyle">STYLE_ENUM_TRANSACTION</obj_property>
         <obj_property name="EnumTransactionColorTable">0=blank ffff=blank 0bad=#FF0000</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
         <obj_property name="CustomSignalColor">turquoise</obj_property>
         <obj_property name="EnumTransactionValueTable">65535=blank</obj_property>
         <obj_property name="Render_Data">/apatb_moving_max_top/AESL_inst_moving_max//AESL_inst_moving_max_activity.dataflowTxWaveData.Cycles</obj_property>
         <obj_property name="Value_Data">/apatb_moving_max_top/AESL_inst_moving_max//AESL_inst_moving_max_activity.dataflowTxWaveData.OutStanding</obj_property>
         <obj_property name="Detail_Data">/apatb_moving_max_top/AESL_inst_moving_max//AESL_inst_moving_max_activity.dataflowTxTooltipData</obj_property>
      </wvobject>
   </wvobject>
