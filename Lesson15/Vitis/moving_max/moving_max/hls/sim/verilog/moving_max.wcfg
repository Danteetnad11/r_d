<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="moving_max.wdb" id="1">
         <top_modules>
            <top_module name="\$unit_dataflow_monitor_sv " />
            <top_module name="\$unit_sv_module_top_sv " />
